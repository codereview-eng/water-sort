    {
      "id": "toolSafe",
      "grantOn": [
        {
          "trigger": "dailyLogin",
          "qty": 1
        }
      ]
    }
  ],
  "ads": {
    "interstitial": {
      "enabled": true,
      "everyN": 5,
      "minGapSec": 60
    },
