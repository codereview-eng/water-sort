{
  "id": "mine",
  "reward": {
    "eMax": 120,
    "eCost": 15,
    "eTickMs": 60000,
    "eAd": 60
  },
  "settle": {
    "mode": "fixed",
    "base": 10,
    "firstClearMult": 3,
    "adBonus": {
      "enabled": true,
      "multiplier": 2,
      "dailyCap": 10,
      "cooldownMs": 60000
    }
  },
  "powerups": [
    {
      "id": "toolMine",
      "grantOn": [
        {
          "trigger": "levelClear",
          "qty": 1
        }
      ]
    },
    {
      "id": "toolSafe",
      "grantOn": [
        {
          "trigger": "dailyLogin",
          "qty": 1
        }
      ]
    }
  ],
  "ads": {
    "interstitial": {
      "enabled": true,
      "everyN": 5,
      "minGapSec": 60
    },
    "geo": {
      "CN": {
        "rewarded": false,
        "interstitial": false
      }
    },
    "placements": {
      "tool-refill": {
        "format": "rewarded",
        "onFail": "deny"
      },
      "fail-revive": {
        "format": "rewarded",
        "onFail": "retry"
      },
      "time-bonus": {
        "format": "rewarded",
        "onFail": "deny",
        "capping": {
          "maxPerSession": 3
        }
      }
    }
  },
  "lifetimeStats": [
    {
      "key": "mines_found",
      "event": "mine_found",
      "agg": "count",
      "label": "找到多少雷"
    },
    {
      "key": "total_clears",
      "event": "level_cleared",
      "agg": "count",
      "label": "通关数"
    },
    {
      "key": "best_level",
      "event": "level_cleared",
      "agg": "max",
      "field": "level",
      "label": "最高关卡"
    }
  ],
  "leaderboards": [
    {
      "id": "top_level",
      "metric": "best_level",
      "order": "desc",
      "operator": "best",
      "period": "none"
    }
  ],
  "i18n": {
    "default": "en",
    "locales": {
      "en": {
        "play": "Play",
        "hint": "Hint"
      },
      "zh": {
        "play": "开始",
        "hint": "提示"
      }
    }
  },
  "geoAccess": {
    "mode": "all"
  },
  "screens": {
    "home": {
      "modules": [
        {
          "type": "logo",
          "props": {
            "icon": "💣",
            "text": "彩色扫雷",
            "em": "COLOR MINES"
          }
        },
        {
          "type": "energy",
          "props": {}
        },
        {
          "type": "homestats",
          "props": {
            "items": [
              {
                "id": "homeLv",
                "label": "当前进度",
                "initial": 1
              },
              {
                "id": "homeClears",
                "label": "累计通关"
              },
              {
                "id": "homeTools",
                "label": "道具"
              }
            ]
          }
        },
        {
          "type": "start-button",
          "props": {
            "label": "开始 第",
            "small": "消耗 15 体力 · 每种颜色 / 每行 / 每列恰好一颗雷"
          }
        },
        {
          "type": "profile-row",
          "props": {}
        },
        {
          "type": "account-row",
          "props": {}
        },
        {
          "type": "sound-toggle",
          "props": {}
        },
        {
          "type": "hintline",
          "props": {
            "lines": [
              "单击 = 标记「不是雷」· 按住拖动 = 批量标记 · 快速双击 = 挖开",
              "雷与雷互不相邻，先推理再动手"
            ]
          }
        }
      ]
    }
  },
  "host": {
    "storagePrefix": "mine:"
  },
  "save": {
    "version": 1
  },
  "platform": {
    "entity": "Save",
    "loginPromptAfterClears": 3,
    "fields": {
      "level": {
        "col": "level",
        "merge": "max"
      },
      "clears": {
        "col": "clears",
        "merge": "max"
      },
      "toolMine": {
        "col": "tool_mine",
        "merge": "newest"
      },
      "toolSafe": {
        "col": "tool_safe",
        "merge": "newest"
      },
      "energy": {
        "col": "energy",
        "merge": "newest"
      },
      "lastTs": {
        "col": "energy_ts",
        "merge": "newest"
      },
      "alias": {
        "col": "alias",
        "merge": "newest"
      },
      "sfx": {
        "col": "sfx",
        "merge": "newest"
      }
    }
  }
}
