      "CN": {
        "rewarded": false,
        "interstitial": false
      }
    },
    "placements": {
      "tool-refill": {
        "format": "rewarded",
        "onFail": "deny"
      },
      "fail-revive": {
        "format": "rewarded",
        "onFail": "retry"
      },
      "time-bonus": {
        "format": "rewarded",
        "onFail": "deny",
        "capping": {
          "maxPerSession": 3
        }
      }
    }
  },
  "lifetimeStats": [
    {
      "key": "mines_found",
      "event": "mine_found",
      "agg": "count",
      "label": "找到多少雷"
    },
    {
      "key": "total_clears",
      "event": "level_cleared",
      "agg": "count",
      "label": "通关数"
    },
    {
      "key": "best_level",
      "event": "level_cleared",
      "agg": "max",
      "field": "level",
      "label": "最高关卡"
    }
